<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboone_perception</name>
  <version>0.0.0</version>
  <description>敵機検出 — D435if の depth と IMU から /opponent と /ring_edge を出す opponent_detector ノード</description>
  <maintainer email="soedayu.030622@gmail.com">auto</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>roboone_interfaces</depend>
  <depend>python3-numpy</depend>

  <!-- depth と IMU の出どころ。既製パッケージ (ros-architecture §2) -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
