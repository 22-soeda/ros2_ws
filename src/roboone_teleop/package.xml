<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboone_teleop</name>
  <version>0.0.0</version>
  <description>PS5 (DualSense) コントローラによる無線操縦 — /joy を /estop・/cmd_walk・/cmd_motion に変換する teleop ノード</description>
  <maintainer email="soedayu.030622@gmail.com">auto</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <!-- 無線テストで ui ノードの LED を光らせるため -->
  <depend>roboone_interfaces</depend>

  <!-- joy_node / game_controller_node の提供元。既製パッケージ (ros-architecture §2) -->
  <exec_depend>joy</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
